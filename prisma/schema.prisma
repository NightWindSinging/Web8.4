generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryType {
  ARTICLE
  PRODUCT
}

enum CategoryNavigationGroup {
  PACKAGING_TYPE
  INDUSTRY
}

enum MediaStorageProvider {
  R2
  LOCAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(80)
  email        String?  @unique @db.VarChar(255)
  name         String?  @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String                   @db.VarChar(160)
  slug            String                   @db.VarChar(160)
  description     String?                  @db.Text
  type            CategoryType
  navigationGroup CategoryNavigationGroup? @map("navigation_group")
  navigationOrder Int                      @default(0) @map("navigation_order")
  navigationImage String?                  @map("navigation_image") @db.VarChar(1200)
  articles        Article[]
  products        Product[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@unique([slug, type])
  @@index([type])
  @@index([type, navigationGroup, navigationOrder])
  @@map("categories")
}

model Article {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(240)
  slug           String        @unique @db.VarChar(180)
  cover          String?       @db.VarChar(1000)
  description    String?       @db.Text
  content        String        @db.Text
  keywords       String[]      @default([])
  status         PublishStatus @default(DRAFT)
  seoTitle       String?       @map("seo_title") @db.VarChar(240)
  seoDescription String?       @map("seo_description") @db.VarChar(500)
  canonicalUrl   String?       @map("canonical_url") @db.VarChar(1000)
  categoryId     String?       @map("category_id") @db.Uuid
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverMediaId   String?       @map("cover_media_id") @db.Uuid
  coverMedia     Media?        @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@map("articles")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(240)
  slug           String        @unique @db.VarChar(180)
  mainImage      String?       @map("main_image") @db.VarChar(1000)
  gallery        String[]      @default([])
  description    String?       @db.Text
  specifications Json?
  seoTitle       String?       @map("seo_title") @db.VarChar(240)
  seoDescription String?       @map("seo_description") @db.VarChar(500)
  canonicalUrl   String?       @map("canonical_url") @db.VarChar(1000)
  keywords       String[]      @default([])
  status         PublishStatus @default(DRAFT)
  categoryId     String?       @map("category_id") @db.Uuid
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mainImageId    String?       @map("main_image_id") @db.Uuid
  mainImageMedia Media?        @relation("ProductMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  galleryMedia   Media[]       @relation("ProductGallery")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@index([createdAt])
  @@map("products")
}

model Media {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(255)
  url               String    @unique @db.VarChar(1200)
  storageKey        String?   @unique @map("storage_key") @db.VarChar(1000)
  storageProvider   MediaStorageProvider @default(LOCAL) @map("storage_provider")
  mimeType          String    @map("mime_type") @db.VarChar(120)
  size              Int?
  width             Int?
  height            Int?
  alt               String?   @db.VarChar(300)
  title             String?   @db.VarChar(255)
  caption           String?   @db.Text
  articleCovers     Article[] @relation("ArticleCover")
  productMainImages Product[] @relation("ProductMainImage")
  galleryProducts   Product[] @relation("ProductGallery")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([storageProvider])
  @@map("media")
}
