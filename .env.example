# Create a Resend API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Destination inbox for website inquiries
INQUIRY_TO_EMAIL=lynn05052002@gmail.com

# Use a sender on a domain verified in Resend before production deployment
INQUIRY_FROM_EMAIL=DATANGXING Website <inquiry@your-verified-domain.com>

# Lightweight CMS administrator. Generate secure local values with: pnpm admin:setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CMS_SESSION_SECRET=

# Digits only, including country code. Example: 8613018787121
NEXT_PUBLIC_WHATSAPP_NUMBER=8613018787121

# Production site origin used for canonical URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Content value from the Google Search Console HTML tag verification method.
# Example tag: <meta name="google-site-verification" content="COPY_THIS_VALUE" />
GOOGLE_SITE_VERIFICATION=

# PostgreSQL connection used by Prisma. Keep the real value in a gitignored
# .env file for Prisma CLI, or in the hosting provider's encrypted variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional one-time administrator creation during `pnpm db:seed`.
# Leave the password empty to seed categories only, then run `pnpm db:admin`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudflare R2 media storage. When all values are configured, the browser
# uploads directly to R2 with a short-lived signed URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.your-domain.com

# Local storage fallback for self-hosted production. Local development is
# enabled automatically. Do not enable this on Vercel's ephemeral filesystem.
MEDIA_LOCAL_STORAGE=false
